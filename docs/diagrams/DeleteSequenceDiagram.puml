@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":InsureConnectParser" as InsureConnectParser LOGIC_COLOR
participant ":DeleteCommandParser" as DeleteCommandParser LOGIC_COLOR
participant "d:DeleteCommand" as DeleteCommand LOGIC_COLOR
participant "c:ConfirmDeleteCommand" as ConfirmDeleteCommand LOGIC_COLOR
participant "dConfirmed:DeleteCommand" as ConfirmedDeleteCommand LOGIC_COLOR
participant "r1:CommandResult" as ConfirmationResult LOGIC_COLOR
participant "r2:CommandResult" as DeletionResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute("delete 1")
activate LogicManager

LogicManager -> InsureConnectParser : parseCommand("delete 1")
activate InsureConnectParser

create DeleteCommandParser
InsureConnectParser -> DeleteCommandParser
activate DeleteCommandParser

DeleteCommandParser --> InsureConnectParser
deactivate DeleteCommandParser

InsureConnectParser -> DeleteCommandParser : parse("1")
activate DeleteCommandParser

create DeleteCommand
DeleteCommandParser -> DeleteCommand
activate DeleteCommand

DeleteCommand --> DeleteCommandParser :
deactivate DeleteCommand

DeleteCommandParser --> InsureConnectParser : d
deactivate DeleteCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
DeleteCommandParser -[hidden]-> InsureConnectParser
destroy DeleteCommandParser

InsureConnectParser --> LogicManager : d
deactivate InsureConnectParser

LogicManager -> DeleteCommand : execute(m)
activate DeleteCommand

create ConfirmationResult
DeleteCommand -> ConfirmationResult
activate ConfirmationResult

ConfirmationResult --> DeleteCommand
deactivate ConfirmationResult

DeleteCommand --> LogicManager : r1
deactivate DeleteCommand

LogicManager -> LogicManager : pendingDeleteCommand = d

[<-- LogicManager
deactivate LogicManager

== User confirms deletion ==

[-> LogicManager : execute("confirm")
activate LogicManager

LogicManager -> InsureConnectParser : parseCommand("confirm")
activate InsureConnectParser

create ConfirmDeleteCommand
InsureConnectParser -> ConfirmDeleteCommand : new ConfirmDeleteCommand()
activate ConfirmDeleteCommand

ConfirmDeleteCommand --> InsureConnectParser : c
deactivate ConfirmDeleteCommand

InsureConnectParser --> LogicManager : c
deactivate InsureConnectParser

LogicManager -> DeleteCommand : confirmed()
activate DeleteCommand

create ConfirmedDeleteCommand
DeleteCommand -> ConfirmedDeleteCommand
activate ConfirmedDeleteCommand

ConfirmedDeleteCommand --> DeleteCommand : dConfirmed
deactivate ConfirmedDeleteCommand

DeleteCommand --> LogicManager : dConfirmed
deactivate DeleteCommand

LogicManager -> LogicManager : pendingDeleteCommand = null

LogicManager -> ConfirmedDeleteCommand : execute(m)
activate ConfirmedDeleteCommand

ConfirmedDeleteCommand -> Model : deletePerson(person)
activate Model

Model --> ConfirmedDeleteCommand
deactivate Model

create DeletionResult
ConfirmedDeleteCommand -> DeletionResult
activate DeletionResult

DeletionResult --> ConfirmedDeleteCommand
deactivate DeletionResult

ConfirmedDeleteCommand --> LogicManager : r2
deactivate ConfirmedDeleteCommand

[<-- LogicManager
deactivate LogicManager
@enduml

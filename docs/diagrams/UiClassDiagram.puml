@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR
skinparam nodesep 60
skinparam ranksep 75

package UI <<Rectangle>>{
Class "<<interface>>\nUi" as Ui
Class "{abstract}\nUiPart" as UiPart
Class UiManager
Class MainWindow
Class HelpWindow
Class ResultDisplay
Class PersonListPanel
Class PersonCard
Class CustomerDetailsPanel
Class CommandBox
Class CommandHistory
Class FocusNavigation
Class ColourSchemeStyles
}

package Model <<Rectangle>> {
Class HiddenModel #FFFFFF
}

package Logic <<Rectangle>> {
Class HiddenLogic #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Ui

UiManager .left.|> Ui
UiManager -down-> "1" MainWindow
MainWindow *-down->  "1" CommandBox
MainWindow *-down-> "1" ResultDisplay
MainWindow *-down-> "1" PersonListPanel
MainWindow *-down-> "1" CustomerDetailsPanel
MainWindow --> "1" HelpWindow
MainWindow .right.> FocusNavigation
MainWindow .left.> ColourSchemeStyles
UiManager .down.> ColourSchemeStyles

PersonListPanel -down-> "*" PersonCard
CommandBox *-down-> "1" CommandHistory

MainWindow -left-|> UiPart

ResultDisplay --|> UiPart
CommandBox --|> UiPart
PersonListPanel --|> UiPart
PersonCard --|> UiPart
CustomerDetailsPanel --|> UiPart
HelpWindow --|> UiPart

PersonCard ..> Model
PersonListPanel ..> Model
CustomerDetailsPanel ..> Model
MainWindow ..> Model
UiManager --> Logic
MainWindow --> Logic
HelpWindow ..> Logic
CommandBox ..> Logic

PersonListPanel -[hidden]left- HelpWindow
CommandBox -[hidden]left- HelpWindow
CommandBox -[hidden]left- ResultDisplay
ResultDisplay -[hidden]left- CustomerDetailsPanel

MainWindow -[hidden]-|> UiPart
HiddenModel -[hidden]right- UiPart
UiPart -[hidden]right- HiddenLogic
@enduml

@startuml ModelClassDiagram
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Package Model as ModelPackage <<Rectangle>>{
Class "<<interface>>\nReadOnlyInsureConnect" as ReadOnlyInsureConnect
Class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
Class "<<interface>>\nModel" as Model
Class InsureConnect
Class ModelManager
Class UserPrefs

Class UniquePersonList
Class Person
Class Address
Class Email
Class Name
Class Phone
Class Tag
Class Remark 
Class CreatedAt

Class I #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Model

InsureConnect .up.|> ReadOnlyInsureConnect

ModelManager .up.|> Model
Model .right.> ReadOnlyUserPrefs
Model .left.> ReadOnlyInsureConnect
ModelManager -left-> "1" InsureConnect
ModelManager -right-> "1" UserPrefs
UserPrefs .up.|> ReadOnlyUserPrefs

InsureConnect *--> "1" UniquePersonList
UniquePersonList --> "*" Person : all
Person *--> "1" Name
Person *--> "1" Phone
Person *--> "1" Email
Person *--> "1" Address
Person *--> "1..*" Tag
Person *--> "1" Remark
Person *--> "1" CreatedAt

Person -[hidden]up--> I
UniquePersonList -[hidden]right-> I

Name -[hidden]right-> Phone
Phone -[hidden]right-> Address
Address -[hidden]right-> Email

ModelManager --> "*" Person : filtered
@enduml

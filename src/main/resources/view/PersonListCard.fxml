<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox id="cardPane"
      fx:id="cardPane"
      minWidth="0"
      minHeight="118"
      maxWidth="Infinity"
      spacing="10"
      styleClass="person-card"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">

  <padding>
    <Insets top="14" right="16" bottom="14" left="16" />
  </padding>

  <HBox alignment="CENTER_LEFT" spacing="12">
    <Label fx:id="id"
           minWidth="44"
           minHeight="44"
           styleClass="card-number" />

    <!-- Separate rows give long email addresses a bounded width so they can wrap. -->
    <VBox minWidth="0"
          spacing="6"
          HBox.hgrow="ALWAYS">

      <Label fx:id="name"
             maxWidth="Infinity"
             wrapText="true"
             styleClass="card-name" />

      <VBox minWidth="0"
            maxWidth="Infinity"
            spacing="5">
        <HBox alignment="CENTER_LEFT" spacing="6">
          <Label text="☎" styleClass="field-icon" />
          <Label fx:id="phone"
                 wrapText="true"
                 styleClass="field-value" />
        </HBox>

        <HBox alignment="CENTER_LEFT"
              spacing="6"
              minWidth="0"
              maxWidth="Infinity">
          <Label text="✉" styleClass="field-icon"/>
          <Label fx:id="email"
                 minWidth="0"
                 maxWidth="Infinity"
                 wrapText="true"
                 HBox.hgrow="ALWAYS"
                 styleClass="field-value" />
        </HBox>
      </VBox>

      <FlowPane fx:id="tags"
                hgap="6"
                vgap="5"
                prefWrapLength="230" />
    </VBox>
  </HBox>
</VBox>
